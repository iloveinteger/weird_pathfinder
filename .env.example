# Public browser configuration. This is the only API key Vite may expose.
VITE_KAKAO_JAVASCRIPT_KEY=

# Public, non-secret provider selection. Real mode currently reports unavailable.
VITE_PROVIDER_MODE=mock
VITE_API_BASE_URL=

# Server/backend-only secrets. Never reference these from browser code.
KAKAO_REST_API_KEY=
DATA_GO_KR_SERVICE_KEY=
SEOUL_OPEN_API_KEY=
SEOUL_SUBWAY_REALTIME_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
